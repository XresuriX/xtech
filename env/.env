APP_API_TIME_OUT= 300000 #// 60000 = 1 minute, 0 = no timeout
APP_API_CLIENT= 'default'
APP_VERSION= '1.0.3'
APP_CODE_VERSION= 1
APP_WEB_URL='https://app.yourdomain.com'
APP_API_DOMAIN='yourdomain.com'
APP_DEFAULT_LOCALE = en
APP_PREFIX_KEY = _myappkey_

# Media Servers - Using mediamtx-moq-xt
# Read via process.env (envFolder injection) - do NOT use VITE_ prefix here:
# Vite only auto-loads .env from the project root, so VITE_* keys in ./env are ignored.
APP_HLS_BASE_URL='https://xrcomms.xamaycatechnologies.cloud:8888'
APP_HLS_TEST_URL='https://test-streams.mux.dev/x36xhzz/x36xhzz.m3u8'
APP_MOQ_BASE_URL='https://relay.example.com/anon'

# Zitadel OIDC (SPA code + PKCE) - see docs/api-audit/04-auth-gap.md
# Redirect URI to register in Zitadel: <origin>/#/auth/callback
# e.g. APP_OIDC_ISSUER='https://zitadel.yourdomain.com'
APP_OIDC_ISSUER=
APP_OIDC_CLIENT_ID=
APP_OIDC_SCOPE='openid profile email offline_access'