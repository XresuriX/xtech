APP_DEV_MODE= 'true'
# Empty base = same-origin relative URLs; quasar.config.ts devServer.proxy forwards
# /api + /ws to http://localhost:8000 (xt-plat). See docs/api-audit/03-config-hosting.md §3.
APP_BASE_API= ''
APP_BASE_CDN_API= ''
APP_PUBLIC_PATH= '/'
# Direct connection (bypasses proxy; requires CORS on backend, which does not exist yet):
# APP_BASE_API= 'http://localhost:8000'
# APP_BASE_CDN_API= 'http://localhost:8000'
